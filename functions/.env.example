# Variables locales para pruebas de Cloud Functions
# Produccion: usar Secret Manager (firebase functions:secrets:set)

GMAIL_CLIENT_ID=tu-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=tu-google-oauth-client-secret

# Opcional: proteccion extra en endpoints Gmail backend
# true = requiere cabecera X-Firebase-AppCheck valida
ENFORCE_APPCHECK=false

# Opcional: lista de origenes permitidos para CORS
# ALLOWED_ORIGINS=https://finanzapp-fb.web.app,https://finanzapp-fb.firebaseapp.com,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173
