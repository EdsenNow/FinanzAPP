# App Check
ENFORCE_APPCHECK=true

# CORS allowed origins (comma separated)
ALLOWED_ORIGINS=https://finanzapp-fb.web.app,https://finanzapp-fb.firebaseapp.com

# Firebase / Google Cloud
GCLOUD_PROJECT=
FUNCTIONS_REGION=us-central1

# Google OAuth (general)
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=https://us-central1-finanzapp-fb.cloudfunctions.net/api/oauth/callback

# Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://us-central1-finanzapp-fb.cloudfunctions.net/api/gmail/oauth/callback

# Gmail Pub/Sub
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SHORT=
GMAIL_WATCH_RENEW_SCHEDULE=0 0 * * *
GMAIL_WATCH_RENEW_MARGIN_MS=3600000

# Cloud KMS key for encrypting Gmail refresh tokens
KMS_KEY_NAME=

# Rate limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# Admin UIDs allowed to reprocess emails (comma separated)
REPROCESS_ADMIN_UIDS=
